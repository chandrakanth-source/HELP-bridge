PORT=5000

DB_USER=postgres
DB_HOST=localhost
DB_NAME=helpbridge
DB_PASSWORD=your-postgres-password
DB_PORT=5432

JWT_SECRET=replace-with-a-long-random-secret

# SMTP provider settings (Gmail, SendGrid SMTP, Mailgun, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-smtp-app-password
MAIL_FROM=HelpBridge <your-email@example.com>
FRONTEND_URL=http://localhost:3000

# Admin setup secret key — required to call /api/admin-setup (one-time use).
ADMIN_SETUP_KEY=replace-with-a-long-random-secret
